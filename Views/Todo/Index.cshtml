@model List<TodoMongoMvc.Models.TodoItem>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="toolbar">
    <a asp-action="Create" role="button">Nova tarefa</a>
</div>

@if (Model.Count == 0)
{
    <p><em>Nenhuma tarefa ainda. Cria a primeira aí em cima.</em></p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Descrição</th>
                    <th>Status</th>
                    <th>Criada em</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var todo in Model)
            {
                <tr class="@(todo.IsDone ? "row-done" : "")">
                    <td>@todo.Title</td>
                    <td>@todo.Description</td>
                    <td>
                        @if (todo.IsDone)
                        {
                            <span class="status-badge done"><span class="dot"></span> concluída</span>
                        }
                        else
                        {
                            <span class="status-badge pending"><span class="dot"></span> pendente</span>
                        }
                    </td>
                    <td class="date-cell">@todo.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <div class="actions-cell">
                            <a asp-action="Edit" asp-route-id="@todo.Id" role="button" class="secondary outline">Editar</a>
                            <form asp-action="Delete" asp-route-id="@todo.Id" method="post">
                                <button type="submit" class="btn-danger-outline outline">Excluir</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
