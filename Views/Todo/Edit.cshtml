@model TodoMongoMvc.Models.TodoItem

@{
    ViewData["Title"] = "Editar tarefa";
}

<h2>Editar tarefa</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <label asp-for="Title">Título</label>
    <input asp-for="Title" required />

    <label asp-for="Description">Descrição</label>
    <textarea asp-for="Description"></textarea>

    <fieldset>
        <label>
            <input asp-for="IsDone" type="checkbox" role="switch" />
            Concluída
        </label>
    </fieldset>

    <button type="submit">Salvar</button>
    <a asp-action="Index" role="button" class="secondary outline">Cancelar</a>
</form>
