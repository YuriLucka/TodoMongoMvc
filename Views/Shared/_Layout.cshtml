<!DOCTYPE html>
<html lang="pt-br" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · TodoMongoMvc</title>
    <link rel="stylesheet" href="~/lib/pico/pico.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <main class="container">
        <header class="app-header">
            <div>
                <span class="eyebrow">MongoDB · Document Store</span>
                <h1><a asp-controller="Todo" asp-action="Index" style="color: inherit; text-decoration: none;">Tarefas</a></h1>
            </div>
            <nav class="header-nav">
                <a asp-controller="Todo" asp-action="Index">Tarefas</a>
                <a asp-controller="Home" asp-action="Index">Sobre</a>
            </nav>
        </header>

        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
